#!/usr/bin/env python3
"""telescoping_operators_complete.py

A single-file, runnable reference implementation of the main computational
constructs discussed in the manuscript "Telescoping Expansions for Integral
Operators and Transforms" (Josh Bald, Jan 2026).

Focus:
- Order-3 exponential engine E_n^{[3]} based on the (2,2) Padé approximant.
- Optional order-5 engine E_n^{[5]} based on a (3,3) Padé approximant.
- Telescoping approximants for:
  * Laplace transforms
  * Fourier transforms
  * Volterra convolution operators (exponential kernels)
  * Matrix exponential / semigroup approximants
  * Duhamel (inhomogeneous linear system) mild-solution approximants
- Convenience routines to reproduce the paper-style numerical tests.

Dependencies (kept minimal): numpy, scipy, matplotlib (for plots; optional).

Notes:
- This script is intended for clarity and reproducibility rather than
  maximum performance.
- Numerical integration over infinite intervals uses QUADPACK via
  scipy.integrate.quad.

Repository referenced in the manuscript:
  https://github.com/jpbald93/telescoping-operators

"""

from __future__ import annotations

import math
import time
import warnings
from dataclasses import dataclass
from typing import Callable, Iterable, Tuple, Optional, Dict

import numpy as np

# SciPy is used for robust quadrature and stable linear algebra.
from scipy.integrate import quad
from scipy.linalg import expm, solve

try:
    import matplotlib.pyplot as plt

    _HAVE_MPL = True
except Exception:
    _HAVE_MPL = False


# =========================================================
# 1) Exponential engines
# =========================================================

def pade_22_scalar(z: complex) -> complex:
    """(2,2) Padé approximant to exp(z)."""
    num = 1 + z / 2 + (z * z) / 12
    den = 1 - z / 2 + (z * z) / 12
    return num / den


def engine_E3_scalar(c: complex, n: int) -> complex:
    """Order-3 telescoping exponential engine E_n^{[3]}(c).

    E_n^{[3]}(c) = P_{2,2}(c/n)^n.
    """
    if n <= 0:
        raise ValueError("n must be positive")
    z = c / n
    return pade_22_scalar(z) ** n


def pade_33_scalar(z: complex) -> complex:
    """A convenient (3,3) Padé approximant to exp(z).

    This is a standard closed form used in the LaTeX edits:
        P_{3,3}(z) = (1 + z/2 + z^2/10 + z^3/120) / (1 - z/2 + z^2/10 - z^3/120)

    It matches exp(z) through order z^6.
    """
    num = 1 + z / 2 + (z * z) / 10 + (z * z * z) / 120
    den = 1 - z / 2 + (z * z) / 10 - (z * z * z) / 120
    return num / den


def engine_E5_scalar(c: complex, n: int) -> complex:
    """Order-5 telescoping exponential engine E_n^{[5]}(c).

    E_n^{[5]}(c) = P_{3,3}(c/n)^n.

    (In the manuscript's terminology, this yields tail O(N^{-5}).)
    """
    if n <= 0:
        raise ValueError("n must be positive")
    z = c / n
    return pade_33_scalar(z) ** n


def engine_Ek_scalar(c: complex, n: int, k: int = 3) -> complex:
    """Convenience dispatcher for scalar engines."""
    if k == 3:
        return engine_E3_scalar(c, n)
    if k == 5:
        return engine_E5_scalar(c, n)
    raise ValueError("Only k in {3,5} implemented in this reference script")


# =========================================================
# 2) Matrix exponential (semigroup) engine
# =========================================================

def pade_22_matrix(Z: np.ndarray) -> np.ndarray:
    """(2,2) Padé rational function for matrices.

    Returns P_{2,2}(Z) = (I + Z/2 + Z^2/12) * (I - Z/2 + Z^2/12)^{-1}
    computed via a linear solve.
    """
    d = Z.shape[0]
    I = np.eye(d, dtype=Z.dtype)
    Z2 = Z @ Z
    numerator = I + Z / 2 + Z2 / 12
    denominator = I - Z / 2 + Z2 / 12

    # Stability diagnostic: condition number of denominator.
    cond = np.linalg.cond(denominator)
    if cond > 1e10:
        warnings.warn(
            f"High condition number in Padé denominator: cond={cond:.3e}. "
            "Results may be ill-conditioned for large ||tA|| or poorly-scaled matrices.",
            RuntimeWarning,
        )

    # Solve denominator * X = numerator
    return solve(denominator, numerator)


def semigroup_Mn_pade22(A: np.ndarray, t: float, n: int) -> np.ndarray:
    """Compute M_n(t) = P_{2,2}(tA/n)^n."""
    if n <= 0:
        raise ValueError("n must be positive")
    Z = (t / n) * A
    P = pade_22_matrix(Z)
    return np.linalg.matrix_power(P, n)


# =========================================================
# 3) Telescoping Laplace transforms
# =========================================================

def telescoping_laplace(
    f: Callable[[float], complex],
    s: complex,
    n: int,
    k: int = 3,
    *,
    epsabs: float = 1e-10,
    epsrel: float = 1e-10,
) -> complex:
    """Compute the telescoping Laplace approximant

        L_n^{(k)}{f}(s) = \int_0^\infty E_n^{[k]}(-s t) f(t) dt.

    Uses quad on [0, inf). SciPy integrates real-valued functions; we split
    into real/imag parts.
    """

    def integrand_real(t: float) -> float:
        val = engine_Ek_scalar(-s * t, n, k=k) * f(t)
        return float(np.real(val))

    def integrand_imag(t: float) -> float:
        val = engine_Ek_scalar(-s * t, n, k=k) * f(t)
        return float(np.imag(val))

    r, _ = quad(integrand_real, 0.0, np.inf, epsabs=epsabs, epsrel=epsrel, limit=200)
    im, _ = quad(integrand_imag, 0.0, np.inf, epsabs=epsabs, epsrel=epsrel, limit=200)
    return r + 1j * im


# =========================================================
# 4) Telescoping Fourier transforms
# =========================================================

def telescoping_fourier(
    f: Callable[[float], complex],
    xi: float,
    n: int,
    k: int = 3,
    *,
    cutoff: float = 12.0,
    epsabs: float = 1e-10,
    epsrel: float = 1e-10,
) -> complex:
    """Compute telescoping Fourier approximant

        f̂_n(ξ) = ∫_{R} E_n^{[k]}(-i ξ t) f(t) dt.

    For generic f, we approximate R by [-cutoff, cutoff]. For Schwartz f
    (e.g. Gaussian), this is excellent.

    If you need exact handling of slow decay, use an oscillatory quadrature
    method or increase cutoff.
    """

    def integrand_real(t: float) -> float:
        val = engine_Ek_scalar(-1j * xi * t, n, k=k) * f(t)
        return float(np.real(val))

    def integrand_imag(t: float) -> float:
        val = engine_Ek_scalar(-1j * xi * t, n, k=k) * f(t)
        return float(np.imag(val))

    r, _ = quad(integrand_real, -cutoff, cutoff, epsabs=epsabs, epsrel=epsrel, limit=200)
    im, _ = quad(integrand_imag, -cutoff, cutoff, epsabs=epsabs, epsrel=epsrel, limit=200)
    return r + 1j * im


# =========================================================
# 5) Volterra convolution operators (exponential kernels)
# =========================================================

def volterra_operator_apply(
    f: Callable[[float], complex],
    lam: complex,
    t: float,
    *,
    exact: bool = True,
    n: int = 50,
    k: int = 3,
    epsabs: float = 1e-10,
    epsrel: float = 1e-10,
) -> complex:
    """Compute (K f)(t) where

        (Kf)(t) = ∫_0^t k(t-τ) f(τ) dτ

    with k(s) = exp(-lam s).

    If exact=True, uses exp kernel.
    If exact=False, uses telescoping kernel approximation k_n(s)=E_n^{[k]}(-lam s).
    """

    def integrand_real(tau: float) -> float:
        s = t - tau
        kern = np.exp(-lam * s) if exact else engine_Ek_scalar(-lam * s, n, k=k)
        val = kern * f(tau)
        return float(np.real(val))

    def integrand_imag(tau: float) -> float:
        s = t - tau
        kern = np.exp(-lam * s) if exact else engine_Ek_scalar(-lam * s, n, k=k)
        val = kern * f(tau)
        return float(np.imag(val))

    r, _ = quad(integrand_real, 0.0, t, epsabs=epsabs, epsrel=epsrel, limit=200)
    im, _ = quad(integrand_imag, 0.0, t, epsabs=epsabs, epsrel=epsrel, limit=200)
    return r + 1j * im


# =========================================================
# 6) Duhamel / mild solution approximants
# =========================================================

def duhamel_solution(
    A: np.ndarray,
    F: Callable[[float], np.ndarray],
    u0: np.ndarray,
    t: float,
    *,
    n: int = 50,
    quad_steps: int = 400,
) -> np.ndarray:
    """Approximate u(t) = exp(tA)u0 + ∫_0^t exp((t-s)A) F(s) ds

    using telescoping semigroup M_n.

    We integrate by a simple composite trapezoid rule on [0,t] for the vector-valued
    integrand. This keeps the code dependency-light and deterministic.
    """
    Mn_t = semigroup_Mn_pade22(A, t, n)

    # composite trapezoid for the integral term
    grid = np.linspace(0.0, t, quad_steps + 1)
    h = t / quad_steps

    acc = np.zeros_like(u0, dtype=np.result_type(u0, A))
    for j, s in enumerate(grid):
        weight = 0.5 if (j == 0 or j == len(grid) - 1) else 1.0
        Mn = semigroup_Mn_pade22(A, t - s, n)
        acc += weight * (Mn @ F(s))

    return Mn_t @ u0 + h * acc


# =========================================================
# 7) Paper-style test cases
# =========================================================

@dataclass
class TestResult:
    n: int
    approx: complex
    exact: complex
    abs_err: float


def test_laplace_exp_kernel(
    s: float = 1.0,
    ns: Iterable[int] = (10, 20, 50, 100, 200),
    k: int = 3,
) -> Tuple[TestResult, ...]:
    """Laplace test: f(t)=exp(-t) => L(s)=1/(s+1)."""
    f = lambda t: np.exp(-t)
    exact = 1.0 / (s + 1.0)

    out = []
    for n in ns:
        approx = telescoping_laplace(f, s, n, k=k)
        out.append(TestResult(n=n, approx=approx, exact=exact, abs_err=float(abs(approx - exact))))
    return tuple(out)


def test_fourier_gaussian(
    xi: float = 1.0,
    ns: Iterable[int] = (10, 30, 50, 100, 200),
    k: int = 3,
    cutoff: float = 10.0,
) -> Tuple[TestResult, ...]:
    """Fourier test: f(t)=exp(-t^2/2), exact fhat(xi)=sqrt(2π)*exp(-xi^2/2)."""
    f = lambda t: np.exp(-0.5 * t * t)
    exact = math.sqrt(2 * math.pi) * math.exp(-0.5 * xi * xi)

    out = []
    for n in ns:
        approx = telescoping_fourier(f, xi, n, k=k, cutoff=cutoff)
        out.append(TestResult(n=n, approx=approx, exact=exact, abs_err=float(abs(approx - exact))))
    return tuple(out)


def test_volterra_sin(
    T: float = 5.0,
    lam: float = 1.0,
    ns: Iterable[int] = (10, 20, 50, 100, 200),
    k: int = 3,
    grid_N: int = 200,
) -> Dict[int, float]:
    """Volterra test: (Kf)(t)=∫_0^t exp(-(t-τ)) sin(τ) dτ.

    Returns L-infty error over t in [0,T] between exact kernel and telescoping kernel.
    """
    f = lambda t: np.sin(t)
    ts = np.linspace(0.0, T, grid_N)

    # exact reference computed by quad each time (slow but robust)
    exact_vals = np.array([volterra_operator_apply(f, lam, t, exact=True) for t in ts])

    errs = {}
    for n in ns:
        approx_vals = np.array(
            [volterra_operator_apply(f, lam, t, exact=False, n=n, k=k) for t in ts]
        )
        errs[n] = float(np.max(np.abs(approx_vals - exact_vals)))
    return errs


def test_matrix_semigroup(
    A: np.ndarray,
    t: float = 1.0,
    ns: Iterable[int] = (10, 20, 50, 100, 200),
) -> Dict[int, float]:
    """Matrix exponential test: Frobenius norm error to expm(tA)."""
    exact = expm(t * A)
    errs = {}
    for n in ns:
        Mn = semigroup_Mn_pade22(A, t, n)
        errs[n] = float(np.linalg.norm(Mn - exact, ord='fro'))
    return errs


# =========================================================
# 8) Plot helpers
# =========================================================

def plot_loglog_errors(ns: Iterable[int], errs: Iterable[float], title: str, ylabel: str):
    if not _HAVE_MPL:
        print("matplotlib not available; skipping plot")
        return

    ns = np.array(list(ns), dtype=float)
    errs = np.array(list(errs), dtype=float)

    plt.figure(figsize=(7, 4.5), dpi=160)
    plt.loglog(ns, errs, marker='o')
    plt.grid(True, which='both', ls='--', alpha=0.4)
    plt.title(title)
    plt.xlabel('n')
    plt.ylabel(ylabel)
    plt.tight_layout()
    plt.show()


# =========================================================
# 9) Main demo
# =========================================================

def main():
    print("=== Telescoping operators: single-file demo ===")
    print("Repository referenced in manuscript:")
    print("  https://github.com/jpbald93/telescoping-operators\n")

    # --- Scalar engine sanity check ---
    n = 50
    c = 1.0
    e3 = engine_E3_scalar(c, n)
    exact = math.e
    print(f"E3_{n}(1)  = {e3:.15f}")
    print(f"exp(1)     = {exact:.15f}")
    print(f"abs error  = {abs(e3-exact):.3e}\n")

    # --- Laplace check: s=2 should be 1/3 ---
    s = 2.0
    lap3 = telescoping_laplace(lambda t: np.exp(-t), s, n=50, k=3)
    lap_exact = 1.0 / (s + 1.0)
    print(f"Laplace (k=3)  L{{e^(-t)}}({s}) approx = {lap3:.6f}")
    print(f"Laplace exact  L{{e^(-t)}}({s}) exact  = {lap_exact:.6f}  (should be ~0.333333)\n")

    # --- Optional order-5 Laplace example (as suggested in the paper edits) ---
    lap5 = telescoping_laplace(lambda t: np.exp(-t), 1.0, n=30, k=5)
    print(f"Order-5 Laplace example: L^(5)_30{{e^(-t)}}(1) = {lap5:.12f}, exact=0.5, err={abs(lap5-0.5):.3e}\n")

    # --- Fourier gaussian test ---
    resF = test_fourier_gaussian(xi=1.0, k=3, cutoff=10.0)
    print("Fourier Gaussian test (xi=1):")
    for r in resF:
        print(f"  n={r.n:4d}  abs_err={r.abs_err:.3e}  approx={r.approx.real:.12f}")
    print()

    # --- Volterra test ---
    vol_errs = test_volterra_sin(T=5.0, lam=1.0, k=3)
    print("Volterra test (L_infty error over t in [0,5]):")
    for n, e in vol_errs.items():
        print(f"  n={n:4d}  err={e:.3e}")
    print()

    # --- Semigroup test ---
    A = np.array([[-1.0, 2.0], [0.0, -1.0]])
    sem_errs = test_matrix_semigroup(A, t=1.0)
    print("Matrix semigroup test (Frobenius error to expm):")
    for n, e in sem_errs.items():
        print(f"  n={n:4d}  err={e:.3e}")
    print()

    # --- Duhamel toy example: forced oscillator in first-order form ---
    # u' = Au + F(t), with A=[[0,1],[-w^2,0]], F=[0, sin(t)]
    w = 2.0
    A = np.array([[0.0, 1.0], [-(w**2), 0.0]])
    u0 = np.array([0.0, 0.0])

    def F(t):
        return np.array([0.0, math.sin(t)])

    t = 3.0
    u_approx = duhamel_solution(A, F, u0, t, n=40, quad_steps=400)
    print("Duhamel demo (forced oscillator, u0=0, t=3):")
    print("  u_n(t) approx =", u_approx)
    print("  (For rigorous validation, compare to high-accuracy ODE solve.)\n")

    # --- Plots ---
    if _HAVE_MPL:
        lap_res = test_laplace_exp_kernel(s=1.0, ns=(10, 20, 50, 100, 200, 500), k=3)
        plot_loglog_errors([r.n for r in lap_res], [r.abs_err for r in lap_res],
                           title="Laplace test: |L_n{e^{-t}}(1) - 0.5|", ylabel="abs error")

        plot_loglog_errors(list(sem_errs.keys()), list(sem_errs.values()),
                           title="Semigroup test: ||M_n(1)-expm(A)||_F", ylabel="Frobenius error")


if __name__ == '__main__':
    main()
